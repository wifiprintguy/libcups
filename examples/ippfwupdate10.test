# information.
#
# Usage:
#
#   ./ipptool [OPTIONS] -f FILENAME -t PRINTER-URI ippfwupdate10.test
#
# Options:
#
#   -d REQUIRE_FWUPDATE=1     Require support for the FWUPDATE specification.
#   -d SKIP_UPDATE=1          Skip the (slow, disruptive) Update-Printer-Firmware
#                             tests - useful when just checking attribute
#                             conformance against a printer you don't want to
#                             actually reboot/interrupt.
#

{
    NAME "IPP FWUPDATE Test 1.1: Current Firmware Attributes"
    OPERATION Get-Printer-Attributes

    GROUP 'operation-attributes-tag'
    ATTR charset "attributes-charset" utf-8
    ATTR naturalLanguage "attributes-natural-language" en
    ATTR uri "printer-uri" $uri
    ATTR keyword "requested-attributes" 'ipp-features-supported','operations-supported','printer-firmware-info-uri','printer-firmware-name','printer-firmware-patches','printer-firmware-string-version','printer-firmware-version'

    STATUS 'successful-ok'

    EXPECT "?ipp-features-supported" IN-GROUP 'printer-attributes-tag' OF-TYPE keyword
    EXPECT "ipp-features-supported" WITH-VALUE 'fwupdate' DEFINE-MATCH PRINTER_HAS_FWUPDATE
    EXPECT "ipp-features-supported" IF-DEFINED "REQUIRE_FWUPDATE"

    EXPECT "operations-supported" WITH-VALUE 0x006b DEFINE-MATCH PRINTER_HAS_CHECK_FOR_NEW_PRINTER_FIRMWARE
    EXPECT "operations-supported" WITH-VALUE 0x006b IF-DEFINED "PRINTER_HAS_FWUPDATE,REQUIRE_FWUPDATE"
    EXPECT "operations-supported" WITH-VALUE 0x006c DEFINE-MATCH PRINTER_HAS_UPDATE_PRINTER_FIRMWARE
    EXPECT "operations-supported" WITH-VALUE 0x006c IF-DEFINED "PRINTER_HAS_FWUPDATE,REQUIRE_FWUPDATE"

    EXPECT "printer-firmware-info-uri" IN-GROUP 'printer-attributes-tag' OF-TYPE uri COUNT 1
    EXPECT "printer-firmware-info-uri" IF-DEFINED "PRINTER_HAS_FWUPDATE,REQUIRE_FWUPDATE"

    # "printer-firmware-name"/"-patches"/"-string-version"/"-version" are PWG
    # 5100.13 (NODRIVER) attributes describing the *currently installed*
    # Firmware. FWUPDATE REQUIRES them (section 8.1), and they define the
    # format the corresponding "printer-new-firmware-*" attributes match
    # (sections 6.3.8, 6.3.10, 6.3.11, and 6.3.13) - so both gates apply
    # below: the PRINTER_HAS_PRINTER_FIRMWARE_XXX checks (from
    # pwg5100.13.test, for internal consistency whenever these happen to be
    # present) and the FWUPDATE gate (for FWUPDATE's own conformance
    # requirement).
    EXPECT "?printer-firmware-name" IN-GROUP 'printer-attributes-tag' OF-TYPE name
    EXPECT "printer-firmware-name" DEFINE-MATCH PRINTER_HAS_PRINTER_FIRMWARE_XXX
    EXPECT "printer-firmware-name" IF-DEFINED "PRINTER_HAS_FWUPDATE,REQUIRE_FWUPDATE"

    EXPECT "?printer-firmware-patches" IN-GROUP 'printer-attributes-tag' OF-TYPE text SAME-COUNT-AS "printer-firmware-name"
    EXPECT "printer-firmware-patches" IF-DEFINED "PRINTER_HAS_PRINTER_FIRMWARE_XXX"
    EXPECT "printer-firmware-patches" IF-DEFINED "PRINTER_HAS_FWUPDATE,REQUIRE_FWUPDATE"

    EXPECT "?printer-firmware-string-version" IN-GROUP 'printer-attributes-tag' OF-TYPE text SAME-COUNT-AS "printer-firmware-name"
    EXPECT "printer-firmware-string-version" IF-DEFINED "PRINTER_HAS_PRINTER_FIRMWARE_XXX"
    EXPECT "printer-firmware-string-version" IF-DEFINED "PRINTER_HAS_FWUPDATE,REQUIRE_FWUPDATE"

    EXPECT "?printer-firmware-version" IN-GROUP 'printer-attributes-tag' OF-TYPE octetString SAME-COUNT-AS "printer-firmware-name"
    EXPECT "printer-firmware-version" IF-DEFINED "PRINTER_HAS_PRINTER_FIRMWARE_XXX"
    EXPECT "printer-firmware-version" IF-DEFINED "PRINTER_HAS_FWUPDATE,REQUIRE_FWUPDATE"

}


{
    NAME "IPP FWUPDATE Test 1.2: Printer attributes"
    OPERATION Get-Printer-Attributes

    GROUP 'operation-attributes-tag'
    ATTR charset "attributes-charset" utf-8
    ATTR naturalLanguage "attributes-natural-language" en
    ATTR uri "printer-uri" $uri
    ATTR keyword "requested-attributes" 'all'

    STATUS 'successful-ok'

    EXPECT "?ipp-features-supported" IN-GROUP 'printer-attributes-tag' OF-TYPE keyword
    EXPECT "ipp-features-supported" WITH-VALUE 'fwupdate' DEFINE-MATCH PRINTER_HAS_FWUPDATE
    EXPECT "ipp-features-supported" IF-DEFINED "REQUIRE_FWUPDATE"

    EXPECT "operations-supported" WITH-VALUE 0x006b DEFINE-MATCH PRINTER_HAS_CHECK_FOR_NEW_PRINTER_FIRMWARE
    EXPECT "operations-supported" WITH-VALUE 0x006b IF-DEFINED "PRINTER_HAS_FWUPDATE,REQUIRE_FWUPDATE"
    EXPECT "operations-supported" WITH-VALUE 0x006c DEFINE-MATCH PRINTER_HAS_UPDATE_PRINTER_FIRMWARE
    EXPECT "operations-supported" WITH-VALUE 0x006c IF-DEFINED "PRINTER_HAS_FWUPDATE,REQUIRE_FWUPDATE"

    # Printer Description attributes (section 6.1-6.2)
    EXPECT "?delay-update-until-supported" IN-GROUP 'printer-attributes-tag' OF-TYPE keyword
    EXPECT "delay-update-until-supported" IF-DEFINED "PRINTER_HAS_FWUPDATE,REQUIRE_FWUPDATE"

    EXPECT "?printer-new-firmware-policy-configured" IN-GROUP 'printer-attributes-tag' OF-TYPE keyword COUNT 1
    EXPECT "printer-new-firmware-policy-configured" WITH-VALUE-FROM "printer-new-firmware-policy-supported"
    EXPECT "printer-new-firmware-policy-configured" IF-DEFINED "PRINTER_HAS_FWUPDATE,REQUIRE_FWUPDATE"

    EXPECT "?printer-new-firmware-policy-supported" IN-GROUP 'printer-attributes-tag' OF-TYPE keyword
    EXPECT "printer-new-firmware-policy-supported" IF-DEFINED "PRINTER_HAS_FWUPDATE,REQUIRE_FWUPDATE"

    EXPECT "?printer-firmware-repository-uri-configured" IN-GROUP 'printer-attributes-tag' OF-TYPE uri COUNT 1
    EXPECT "printer-firmware-repository-uri-configured" DEFINE-MATCH PRINTER_HAS_FIRMWARE_REPOSITORY

    EXPECT "?printer-firmware-repository-uri-supported" IN-GROUP 'printer-attributes-tag' OF-TYPE uri
    EXPECT "printer-firmware-repository-uri-supported" IF-DEFINED "PRINTER_HAS_FIRMWARE_REPOSITORY"

    EXPECT "printer-firmware-info-uri" IN-GROUP 'printer-attributes-tag' OF-TYPE uri COUNT 1
    EXPECT "printer-firmware-info-uri" IF-DEFINED "PRINTER_HAS_FWUPDATE,REQUIRE_FWUPDATE"

    # "printer-firmware-name"/"-patches"/"-string-version"/"-version" are PWG
    # 5100.13 (NODRIVER) attributes describing the *currently installed*
    # Firmware. FWUPDATE REQUIRES them (section 8.1), and they define the
    # format the corresponding "printer-new-firmware-*" attributes match
    # (sections 6.3.8, 6.3.10, 6.3.11, and 6.3.13) - so both gates apply
    # below: the PRINTER_HAS_PRINTER_FIRMWARE_XXX checks (from
    # pwg5100.13.test, for internal consistency whenever these happen to be
    # present) and the FWUPDATE gate (for FWUPDATE's own conformance
    # requirement).
    EXPECT "?printer-firmware-name" IN-GROUP 'printer-attributes-tag' OF-TYPE name
    EXPECT "printer-firmware-name" DEFINE-MATCH PRINTER_HAS_PRINTER_FIRMWARE_XXX
    EXPECT "printer-firmware-name" IF-DEFINED "PRINTER_HAS_FWUPDATE,REQUIRE_FWUPDATE"

    EXPECT "?printer-firmware-patches" IN-GROUP 'printer-attributes-tag' OF-TYPE text SAME-COUNT-AS "printer-firmware-name"
    EXPECT "printer-firmware-patches" IF-DEFINED "PRINTER_HAS_PRINTER_FIRMWARE_XXX"
    EXPECT "printer-firmware-patches" IF-DEFINED "PRINTER_HAS_FWUPDATE,REQUIRE_FWUPDATE"

    EXPECT "?printer-firmware-string-version" IN-GROUP 'printer-attributes-tag' OF-TYPE text SAME-COUNT-AS "printer-firmware-name"
    EXPECT "printer-firmware-string-version" IF-DEFINED "PRINTER_HAS_PRINTER_FIRMWARE_XXX"
    EXPECT "printer-firmware-string-version" IF-DEFINED "PRINTER_HAS_FWUPDATE,REQUIRE_FWUPDATE"

    EXPECT "?printer-firmware-version" IN-GROUP 'printer-attributes-tag' OF-TYPE octetString SAME-COUNT-AS "printer-firmware-name"
    EXPECT "printer-firmware-version" IF-DEFINED "PRINTER_HAS_PRINTER_FIRMWARE_XXX"
    EXPECT "printer-firmware-version" IF-DEFINED "PRINTER_HAS_FWUPDATE,REQUIRE_FWUPDATE"

    # Printer Status attributes (section 6.3) - always REQUIRED to be
    # returned (with out-of-band values when there's nothing to report yet),
    # so these are unconditional once we know the printer supports FWUPDATE.
    EXPECT "printer-firmware-update-date-time" IN-GROUP 'printer-attributes-tag' OF-TYPE dateTime|no-value COUNT 1
    EXPECT "printer-firmware-update-date-time" IF-DEFINED "PRINTER_HAS_FWUPDATE,REQUIRE_FWUPDATE"

    EXPECT "printer-new-firmware-check-date-time" IN-GROUP 'printer-attributes-tag' OF-TYPE dateTime|no-value|unknown COUNT 1
    EXPECT "printer-new-firmware-check-date-time" IF-DEFINED "PRINTER_HAS_FWUPDATE,REQUIRE_FWUPDATE"

    EXPECT "printer-new-firmware-info-uri" IN-GROUP 'printer-attributes-tag' OF-TYPE uri|no-value|unknown COUNT 1
    EXPECT "printer-new-firmware-info-uri" IF-DEFINED "PRINTER_HAS_FWUPDATE,REQUIRE_FWUPDATE"

    EXPECT "printer-new-firmware-k-octets" IN-GROUP 'printer-attributes-tag' OF-TYPE integer(1:MAX)|no-value|unknown
    EXPECT "printer-new-firmware-k-octets" IF-DEFINED "PRINTER_HAS_FWUPDATE,REQUIRE_FWUPDATE"

    EXPECT "printer-new-firmware-name" IN-GROUP 'printer-attributes-tag' OF-TYPE name|no-value|unknown
    EXPECT "printer-new-firmware-name" IF-DEFINED "PRINTER_HAS_FWUPDATE,REQUIRE_FWUPDATE"

    # "printer-new-firmware-offline-time" is OPTIONAL (section 6.3.9).
    EXPECT "?printer-new-firmware-offline-time" IN-GROUP 'printer-attributes-tag' OF-TYPE integer(0:MAX)|no-value|unknown COUNT 1

    EXPECT "printer-new-firmware-patches" IN-GROUP 'printer-attributes-tag' OF-TYPE text|no-value|unknown
    EXPECT "printer-new-firmware-patches" IF-DEFINED "PRINTER_HAS_FWUPDATE,REQUIRE_FWUPDATE"

    EXPECT "printer-new-firmware-string-version" IN-GROUP 'printer-attributes-tag' OF-TYPE text|no-value|unknown
    EXPECT "printer-new-firmware-string-version" IF-DEFINED "PRINTER_HAS_FWUPDATE,REQUIRE_FWUPDATE"

    EXPECT "printer-new-firmware-urgency" IN-GROUP 'printer-attributes-tag' OF-TYPE keyword|no-value|unknown COUNT 1
    EXPECT "printer-new-firmware-urgency" IF-DEFINED "PRINTER_HAS_FWUPDATE,REQUIRE_FWUPDATE"

    EXPECT "printer-new-firmware-version" IN-GROUP 'printer-attributes-tag' OF-TYPE octetString|no-value|unknown
    EXPECT "printer-new-firmware-version" IF-DEFINED "PRINTER_HAS_FWUPDATE,REQUIRE_FWUPDATE"

    # Remember whether "indefinite" is a supported delay for Test 3.2.
    EXPECT "delay-update-until-supported" WITH-VALUE 'indefinite' DEFINE-MATCH PRINTER_HAS_DELAY_INDEFINITE
}

{
    NAME "IPP FWUPDATE Test 2.1: Check-For-New-Printer-Firmware"
    OPERATION Check-For-New-Printer-Firmware
    SKIP-IF-NOT-DEFINED PRINTER_HAS_CHECK_FOR_NEW_PRINTER_FIRMWARE

    GROUP 'operation-attributes-tag'
    ATTR charset "attributes-charset" utf-8
    ATTR naturalLanguage "attributes-natural-language" en
    ATTR uri "printer-uri" $uri

    STATUS 'successful-ok'

    # All Group 2 attributes here are OPTIONAL (section 5.1.2) - just check
    # the types of whichever ones the Printer chose to include.
    EXPECT "?printer-new-firmware-check-date-time" OF-TYPE dateTime|no-value|unknown
    EXPECT "?printer-new-firmware-info-uri" OF-TYPE uri|unknown|no-value
    EXPECT "?printer-new-firmware-k-octets" OF-TYPE integer(1:MAX)|unknown|no-value
    EXPECT "?printer-new-firmware-name" OF-TYPE name|unknown|no-value
    EXPECT "?printer-new-firmware-patches" OF-TYPE text|unknown|no-value
    EXPECT "?printer-new-firmware-string-version" OF-TYPE text|unknown|no-value
    EXPECT "?printer-new-firmware-urgency" OF-TYPE keyword|unknown|no-value
    EXPECT "?printer-new-firmware-version" OF-TYPE octetString|unknown|no-value
}

{
    NAME "IPP FWUPDATE Test 2.2: Printer reports check-date-time after Check-For-New-Printer-Firmware"
    OPERATION Get-Printer-Attributes
    SKIP-IF-NOT-DEFINED PRINTER_HAS_CHECK_FOR_NEW_PRINTER_FIRMWARE

    GROUP 'operation-attributes-tag'
    ATTR charset "attributes-charset" utf-8
    ATTR naturalLanguage "attributes-natural-language" en
    ATTR uri "printer-uri" $uri
    ATTR keyword "requested-attributes" 'printer-new-firmware-check-date-time','printer-new-firmware-name','printer-new-firmware-patches','printer-new-firmware-string-version','printer-new-firmware-version','printer-state-reasons'

    STATUS 'successful-ok'

    # The check time is updated even when the repository can't be reached
    # (section 6.3.3), so after a check it is never 'no-value'.
    EXPECT "printer-new-firmware-check-date-time" OF-TYPE dateTime|unknown
    DISPLAY "printer-state-reasons"

    # A compliant Printer has no new Firmware pending most of the time -
    # that's a normal, valid state, not a conformance problem. Only define
    # NEW_FIRMWARE_AVAILABLE (and so only run Tests 2.3 and 3.2-3.5 below)
    # when the Printer is actually reporting some (section 7.3.9); otherwise
    # there's nothing real to install or to compare "printer-firmware-xxx"
    # against.
    EXPECT "?printer-state-reasons" WITH-VALUE 'firmware-update-available' DEFINE-MATCH NEW_FIRMWARE_AVAILABLE
    EXPECT "?printer-state-reasons" WITH-VALUE '/^firmware-repository-(access-error|unreachable)$/' DEFINE-MATCH FIRMWARE_REPOSITORY_ERROR

    # Capture the discovered new Firmware's info so Test 3.5 can confirm it
    # matches "printer-firmware-xxx" (the currently installed Firmware)
    # after Update-Printer-Firmware installs it.
    EXPECT "printer-new-firmware-name" DEFINE-VALUE NEW_FIRMWARE_NAME
    EXPECT "printer-new-firmware-patches" DEFINE-VALUE NEW_FIRMWARE_PATCHES
    EXPECT "printer-new-firmware-string-version" DEFINE-VALUE NEW_FIRMWARE_STRING_VERSION
    EXPECT "printer-new-firmware-version" DEFINE-VALUE NEW_FIRMWARE_VERSION
}

{
    NAME "IPP FWUPDATE Test 2.3: New Firmware attributes have values when firmware-update-available"
    OPERATION Get-Printer-Attributes
    SKIP-IF-NOT-DEFINED NEW_FIRMWARE_AVAILABLE

    GROUP 'operation-attributes-tag'
    ATTR charset "attributes-charset" utf-8
    ATTR naturalLanguage "attributes-natural-language" en
    ATTR uri "printer-uri" $uri
    ATTR keyword "requested-attributes" 'printer-new-firmware-info-uri','printer-new-firmware-k-octets','printer-new-firmware-name','printer-new-firmware-offline-time','printer-new-firmware-patches','printer-new-firmware-string-version','printer-new-firmware-urgency','printer-new-firmware-version','printer-state-reasons'

    STATUS 'successful-ok'

    # Section 7.3.9: 'firmware-update-available' is listed if and only if
    # the Table 1 attributes report real values.
    EXPECT "printer-new-firmware-info-uri" OF-TYPE uri COUNT 1
    EXPECT "printer-new-firmware-k-octets" OF-TYPE integer(1:MAX)|unknown
    EXPECT "printer-new-firmware-name" OF-TYPE name
    EXPECT "?printer-new-firmware-offline-time" OF-TYPE integer(0:MAX) COUNT 1
    EXPECT "printer-new-firmware-patches" OF-TYPE text SAME-COUNT-AS "printer-new-firmware-name"
    EXPECT "printer-new-firmware-string-version" OF-TYPE text SAME-COUNT-AS "printer-new-firmware-name"
    EXPECT "printer-new-firmware-urgency" OF-TYPE keyword COUNT 1
    EXPECT "printer-new-firmware-version" OF-TYPE octetString SAME-COUNT-AS "printer-new-firmware-name"
}

{
    NAME "IPP FWUPDATE Test 2.4: New Firmware attributes are 'unknown' after a repository error"
    OPERATION Get-Printer-Attributes
    SKIP-IF-NOT-DEFINED FIRMWARE_REPOSITORY_ERROR

    GROUP 'operation-attributes-tag'
    ATTR charset "attributes-charset" utf-8
    ATTR naturalLanguage "attributes-natural-language" en
    ATTR uri "printer-uri" $uri
    ATTR keyword "requested-attributes" 'printer-new-firmware-info-uri','printer-new-firmware-k-octets','printer-new-firmware-name','printer-new-firmware-offline-time','printer-new-firmware-patches','printer-new-firmware-string-version','printer-new-firmware-urgency','printer-new-firmware-version'

    STATUS 'successful-ok'

    # Section 4.3: a failed check sets the Table 1 attributes to 'unknown'.
    EXPECT "printer-new-firmware-info-uri" OF-TYPE unknown
    EXPECT "printer-new-firmware-k-octets" OF-TYPE unknown
    EXPECT "printer-new-firmware-name" OF-TYPE unknown
    EXPECT "?printer-new-firmware-offline-time" OF-TYPE unknown
    EXPECT "printer-new-firmware-patches" OF-TYPE unknown
    EXPECT "printer-new-firmware-string-version" OF-TYPE unknown
    EXPECT "printer-new-firmware-urgency" OF-TYPE unknown
    EXPECT "printer-new-firmware-version" OF-TYPE unknown
}

{
    NAME "IPP FWUPDATE Test 3.1: Update-Printer-Firmware rejects conflicting delay attributes"
    OPERATION Update-Printer-Firmware
    SKIP-IF-NOT-DEFINED PRINTER_HAS_UPDATE_PRINTER_FIRMWARE

    GROUP 'operation-attributes-tag'
    ATTR charset "attributes-charset" utf-8
    ATTR naturalLanguage "attributes-natural-language" en
    ATTR uri "printer-uri" $uri
    ATTR keyword "delay-update-until" 'no-delay'
    ATTR dateTime "delay-update-until-date-time" 2030-01-01T00:00:00Z

    STATUS 'client-error-conflicting-attributes'
}

{
    NAME "IPP FWUPDATE Test 3.2: Update-Printer-Firmware schedules an indefinite delay"
    OPERATION Update-Printer-Firmware
    SKIP-IF-NOT-DEFINED PRINTER_HAS_UPDATE_PRINTER_FIRMWARE
    SKIP-IF-NOT-DEFINED PRINTER_HAS_DELAY_INDEFINITE
    SKIP-IF-NOT-DEFINED NEW_FIRMWARE_AVAILABLE
    SKIP-IF-DEFINED SKIP_UPDATE

    GROUP 'operation-attributes-tag'
    ATTR charset "attributes-charset" utf-8
    ATTR naturalLanguage "attributes-natural-language" en
    ATTR uri "printer-uri" $uri
    ATTR keyword "delay-update-until" 'indefinite'

    STATUS 'successful-ok'

    # Section 5.2.1: the response reports the accepted delay. Test 3.3
    # replaces this scheduled update with an immediate one.
    EXPECT "?printer-new-firmware-delayed-until" OF-TYPE keyword COUNT 1 WITH-VALUE 'indefinite'
}

{
    NAME "IPP FWUPDATE Test 3.2.1: Printer reports the pending update"
    OPERATION Get-Printer-Attributes
    SKIP-IF-NOT-DEFINED PRINTER_HAS_UPDATE_PRINTER_FIRMWARE
    SKIP-IF-NOT-DEFINED PRINTER_HAS_DELAY_INDEFINITE
    SKIP-IF-NOT-DEFINED NEW_FIRMWARE_AVAILABLE
    SKIP-IF-DEFINED SKIP_UPDATE

    GROUP 'operation-attributes-tag'
    ATTR charset "attributes-charset" utf-8
    ATTR naturalLanguage "attributes-natural-language" en
    ATTR uri "printer-uri" $uri
    ATTR keyword "requested-attributes" 'printer-new-firmware-delayed-until','printer-new-firmware-delayed-until-date-time','printer-state-reasons'

    STATUS 'successful-ok'

    EXPECT "printer-state-reasons" WITH-VALUE 'firmware-update-pending'
    EXPECT "printer-new-firmware-delayed-until" OF-TYPE keyword COUNT 1 WITH-VALUE 'indefinite'
    EXPECT !printer-new-firmware-delayed-until-date-time
}

{
    NAME "IPP FWUPDATE Test 3.3: Update-Printer-Firmware installs available firmware now"
    OPERATION Update-Printer-Firmware
    SKIP-IF-NOT-DEFINED PRINTER_HAS_UPDATE_PRINTER_FIRMWARE
    SKIP-IF-NOT-DEFINED NEW_FIRMWARE_AVAILABLE
    SKIP-IF-DEFINED SKIP_UPDATE

    GROUP 'operation-attributes-tag'
    ATTR charset "attributes-charset" utf-8
    ATTR naturalLanguage "attributes-natural-language" en
    ATTR uri "printer-uri" $uri
    ATTR keyword "delay-update-until" 'no-delay'

    # This request returns before the Printer begins the Firmware Update
    # (section 5.2) - the next test polls for completion.
    STATUS 'successful-ok'
}

{
    NAME "IPP FWUPDATE Test 3.4: firmware update reaches a terminal state"
    OPERATION Get-Printer-Attributes
    SKIP-IF-NOT-DEFINED PRINTER_HAS_UPDATE_PRINTER_FIRMWARE
    SKIP-IF-NOT-DEFINED NEW_FIRMWARE_AVAILABLE
    SKIP-IF-DEFINED SKIP_UPDATE
    # Wrap value for DELAY in quotes to get a comma separated value past the parser...
    DELAY "0,2"

    GROUP 'operation-attributes-tag'
    ATTR charset "attributes-charset" utf-8
    ATTR naturalLanguage "attributes-natural-language" en
    ATTR uri "printer-uri" $uri
    ATTR keyword "requested-attributes" 'printer-state','printer-state-reasons'

    STATUS 'successful-ok'

    DISPLAY "printer-state-reasons"

    # Keep polling every 1-2 seconds while the update is pending, running,
    # aborting, or restarting (sections 4.6 and 7.3); once all of those are
    # gone it's done. Success ('firmware-update-completed') and failure
    # ('firmware-update-aborted') are both valid outcomes for this generic
    # conformance check. Note: a real Printer can be unreachable while it
    # restarts (section 4.5).
    EXPECT "printer-state-reasons" WITH-VALUE '/^(firmware-update-(pending|processing|aborting)|restarting)$/' REPEAT-MATCH
    EXPECT "?printer-state-reasons" WITH-VALUE 'firmware-update-completed' DEFINE-MATCH FIRMWARE_UPDATE_COMPLETED
}

{
    NAME "IPP FWUPDATE Test 3.5: currently installed Firmware matches what was installed"
    OPERATION Get-Printer-Attributes
    SKIP-IF-NOT-DEFINED PRINTER_HAS_UPDATE_PRINTER_FIRMWARE
    SKIP-IF-NOT-DEFINED NEW_FIRMWARE_AVAILABLE
    SKIP-IF-NOT-DEFINED FIRMWARE_UPDATE_COMPLETED
    SKIP-IF-DEFINED SKIP_UPDATE

    GROUP 'operation-attributes-tag'
    ATTR charset "attributes-charset" utf-8
    ATTR naturalLanguage "attributes-natural-language" en
    ATTR uri "printer-uri" $uri
    ATTR keyword "requested-attributes" 'printer-firmware-name','printer-firmware-patches','printer-firmware-string-version','printer-firmware-update-date-time','printer-firmware-version','printer-is-accepting-jobs','printer-state','printer-state-reasons'

    STATUS 'successful-ok'

    # Section 4.6: after a successful update the Printer is back in service
    # and reports when the running Firmware was installed.
    EXPECT "printer-is-accepting-jobs" WITH-VALUE true
    EXPECT "printer-state" WITH-VALUE 3
    EXPECT "printer-firmware-update-date-time" OF-TYPE dateTime COUNT 1

    # The Firmware that was reported as available (captured in Test 2.2)
    # should now be what's currently installed.
    EXPECT "printer-firmware-name" WITH-VALUE "$NEW_FIRMWARE_NAME" IF-DEFINED "NEW_FIRMWARE_NAME"
    EXPECT "printer-firmware-patches" WITH-VALUE "$NEW_FIRMWARE_PATCHES" IF-DEFINED "NEW_FIRMWARE_PATCHES"
    EXPECT "printer-firmware-string-version" WITH-VALUE "$NEW_FIRMWARE_STRING_VERSION" IF-DEFINED "NEW_FIRMWARE_STRING_VERSION"
    EXPECT "printer-firmware-version" WITH-VALUE "$NEW_FIRMWARE_VERSION" IF-DEFINED "NEW_FIRMWARE_VERSION"
}
